<svg width="48" height="48" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="qf-fav-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e1b4b" />
      <stop offset="50%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>
    <linearGradient id="qf-fav-trend" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="50%" stop-color="#818cf8" />
      <stop offset="100%" stop-color="#34d399" />
    </linearGradient>
    <linearGradient id="qf-fav-bar1" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#2563eb" stop-opacity="0.25" />
    </linearGradient>
    <linearGradient id="qf-fav-bar2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#818cf8" stop-opacity="0.95" />
      <stop offset="100%" stop-color="#4f46e5" stop-opacity="0.3" />
    </linearGradient>
    <linearGradient id="qf-fav-bar3" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#34d399" stop-opacity="1" />
      <stop offset="100%" stop-color="#059669" stop-opacity="0.35" />
    </linearGradient>
    <filter id="qf-fav-glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="0.8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>
  <rect x="1.5" y="1.5" width="29" height="29" rx="8" fill="url(#qf-fav-bg)" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1" />
  <rect x="7" y="16.5" width="3.5" height="8.5" rx="1.5" fill="url(#qf-fav-bar1)" />
  <rect x="13" y="12.5" width="3.5" height="12.5" rx="1.5" fill="url(#qf-fav-bar2)" />
  <rect x="19" y="8" width="3.5" height="17" rx="1.5" fill="url(#qf-fav-bar3)" />
  <path d="M6 20.5C9.5 17.5 11.5 16 14.5 13C17.5 10 19.5 10.5 25.5 6" stroke="url(#qf-fav-trend)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" filter="url(#qf-fav-glow)" />
  <circle cx="25.5" cy="6" r="3.6" fill="#34d399" opacity="0.3" />
  <circle cx="25.5" cy="6" r="2.2" fill="#34d399" />
  <circle cx="25.5" cy="6" r="0.9" fill="#ffffff" />
</svg>
